# Normalizacion de fin de linea. Sin esto, en Windows los .sh y los archivos
# que se montan dentro del contenedor Linux llegan con CRLF y fallan.
* text=auto eol=lf

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.pdf binary

# Los JSON de los workflows son artefactos generados: el diff completo en cada
# build es ruido en las revisiones.
# linguist-generated colapsa el diff en GitHub, pero se mantiene diferenciable
# en local: si un cambio en src/nodes/ produce algo inesperado en el JSON, hay
# que poder verlo.
workflows/*.json linguist-generated=true

# =============================================================================
# MERCAMIO - ChatBOT contable | plantilla de configuracion
# =============================================================================
# Copia este archivo a .env y rellena los valores. .env ESTA EN .gitignore:
# nunca debe subirse al repositorio.
#
#   cp .env.example .env                 (Git Bash / Linux / macOS)
#   Copy-Item .env.example .env          (PowerShell)
# =============================================================================

# -------------------------- 1. Base de datos --------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
POSTGRES_DB=n8n

# -------------------------- 2. Cifrado de n8n -------------------------------
# CRITICO. Cifra las credenciales guardadas en la base de datos. Si la pierdes
# o la cambias, TODAS las credenciales quedan ILEGIBLES y hay que reconectar
# WhatsApp y Google a mano. Guardala en el gestor de contrasenas.
#
# Generar una (elige uno):
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=

# -------------------------- 3. Red y acceso ---------------------------------
N8N_PORT_HOST=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
TZ=America/Bogota
N8N_LOG_LEVEL=info

# URL publica que n8n informa a Meta y a Google en los webhooks y en los
# callbacks de OAuth.
#   Solo simulador local .......... http://localhost:5678/
#   Con tunel de Cloudflare ....... https://tu-tunel.trycloudflare.com/
# Si esto no coincide con la URL real, Meta no entrega los mensajes.
WEBHOOK_URL=http://localhost:5678/

# Token del tunel de Cloudflare (perfil "tunnel"). Ver docs/03.
TUNNEL_TOKEN=

# -------------------------- 4. Retencion de datos ---------------------------
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# -------------------------- 5. Chatbot MERCAMIO -----------------------------
# ID de la hoja de calculo donde se registran las solicitudes. Es el tramo
# entre /d/ y /edit en la URL de Google Sheets.
MERCAMIO_SHEET_ID=

# Ruta al JSON de la clave de la CUENTA DE SERVICIO de Google, FUERA de este
# repositorio. Lo crea scripts/crear-credencial-sheets.ps1 en n8n.
#
# Se usa cuenta de servicio y no OAuth2 porque MERCAMIO no tiene Google
# Workspace: la pantalla de consentimiento solo puede ser Externa, y en estado
# "Testing" Google caduca el refresh token a los 7 dias. El nodo de Sheets lleva
# onError continueRegularOutput, asi que el bot seguiria dando numeros de ticket
# sin escribir nada. Una cuenta de servicio no caduca.
#   GOOGLE_SA_KEY_FILE=C:\Users\hamil\.secretos\mercamio-sa.json
GOOGLE_SA_KEY_FILE=

# Con "true", el SIMULADOR tambien escribe en Sheets. Sirve para comprobar que
# los tickets llegan de verdad a la hoja sin montar todavia WhatsApp: si se
# prueban las dos cosas a la vez, un fallo tiene dos causas posibles.
# Se lee en tiempo de build, asi que hay que reimportar tras cambiarlo.
MERCAMIO_SIM_SHEETS=false

MERCAMIO_PORTAL_URL=https://mercamio.com.co/proveedores/

# Minutos de inactividad tras los que se descarta una conversacion a medias.
MERCAMIO_SESSION_TTL_MIN=60
# Tope de conversaciones en memoria (protege el static data del workflow).
MERCAMIO_MAX_SESSIONS=500

# -- Responsables y SLA por ruta ---------------------------------------------
# Los correos internos NO estan en el codigo: se inyectan aqui. Debe ir en UNA
# sola linea (docker compose no admite saltos de linea sin comillas).
#
# Rutas: CLI_RET, CLI_CAR, PRO_PEN, PRO_CER, ACR_DIF, ACR_PEN, ACR_CER
# Campos por ruta: owner, sla, escalate (true si el responsable esta sin definir)
#
# Ejemplo (reemplaza por los correos reales de contabilidad):
# MERCAMIO_ROUTES_JSON={"CLI_RET":{"owner":"correo.ruta.cli-ret@ejemplo.local","sla":"3 dias"},"CLI_CAR":{"owner":"Responsable de cartera por confirmar","escalate":true},"PRO_PEN":{"owner":"correo.ruta.pro-pen@ejemplo.local","sla":"2 dias"},"PRO_CER":{"owner":"correo.ruta.pro-cer@ejemplo.local"},"ACR_DIF":{"owner":"correo.ruta.acr@ejemplo.local","sla":"3 dias"},"ACR_PEN":{"owner":"Triage contabilidad - responsable por confirmar","escalate":true},"ACR_CER":{"owner":"correo.ruta.acr@ejemplo.local"}}
MERCAMIO_ROUTES_JSON=

# -------------------------- 6. Version de n8n -------------------------------
# Fijada a proposito: "latest" rompe flujos sin avisar en una actualizacion.
N8N_VERSION=1.117.2

# -------------------------- 7. Herramientas ---------------------------------
ADMINER_PORT_HOST=8080

# ============== 8. WhatsApp: SOLO para scripts/verificar-whatsapp.ps1 ========
# n8n guarda sus propias credenciales CIFRADAS en la base de datos. Estas
# variables son unicamente para el diagnostico por linea de comandos, y puedes
# borrarlas cuando termines de configurar.
#
# Donde sacar cada valor: docs/09-registrar-numero-whatsapp.md
#
# El token permanente es un secreto de primer nivel: da acceso a enviar
# mensajes en nombre de MERCAMIO. .env esta en .gitignore, pero aun asi
# guardalo en el gestor de contrasenas y no lo pegues en chats ni tickets.
# Token permanente y WABA ID -> Meta > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=

# App ID y App Secret -> Meta > Configuracion > Basica
# OJO: la credencial del TRIGGER usa estos dos, NO el access token. Es la
# confusion mas comun al configurar WhatsApp en n8n.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
